# Par défaut tout tourne en local avec Ollama (aucune clé nécessaire).
LLM_PROVIDER=ollama
# Pour OpenAI : LLM_PROVIDER=openai puis renseigner la clé.
OPENAI_API_KEY=
# Optionnel : active TavilySearch (https://tavily.com)
TAVILY_API_KEY=
# Optionnel : traces LangSmith / LangGraph Studio
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
